# Copy this file to .env and configure for your environment

# Local development (Docker)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/classmateai

# Production (Supabase)
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.xbgifhfbzhcvdbujfqma.supabase.co:5432/postgres

# JWT — generate a new key with: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Brevo — get a key at https://developers.brevo.com/
BREVO_API_KEY=your_key_here
EMAIL_FROM=classmateai@example.com
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFY_EXPIRE_MINUTES=60

# Auth cookies — required for cross-origin production (frontend + API on different hosts)
# Local dev: COOKIE_SECURE=false and COOKIE_SAMESITE=lax (defaults)
# Production (Vercel):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Optional: comma-separated extra browser origins for CORS (merged with built-in defaults).
# CORS_ORIGINS=https://your-preview.vercel.app